SELECT * 
FROM DIM_CUSTOMER;

SELECT * 
FROM DIM_ACCOUNT;

SELECT * 
FROM DIM_BRANCH;

SELECT * 
FROM DIM_DATE;

SELECT * 
FROM FACT_TRANSACTIONS;


--balance

SELECT
    c.CUSTOMER_NAME,
    SUM(
        CASE
            WHEN f.TRANSACTION_TYPE = 'Deposit'
                THEN f.AMOUNT
            WHEN f.TRANSACTION_TYPE = 'Withdrawal'
                THEN -f.AMOUNT
        END
    ) AS BALANCE
FROM FACT_TRANSACTIONS f
JOIN DIM_CUSTOMER c
ON f.CUSTOMER_KEY = c.CUSTOMER_KEY
GROUP BY c.CUSTOMER_NAME
ORDER BY c.CUSTOMER_NAME;


--Total Transaction Amount by Customer

SELECT
    c.Customer_Name, f.Transaction_Type,
    SUM(f.Amount) AS Total_Amount
FROM Fact_Transactions f
JOIN Dim_Customer c
ON f.Customer_Key = c.Customer_Key
GROUP BY c.Customer_Name, f.Transaction_Type
order by c.Customer_Name;


--Total Deposit by Customer

SELECT
    c.Customer_Name,
    SUM(f.Amount) AS Deposit_Amount
FROM Fact_Transactions f
JOIN Dim_Customer c
ON f.Customer_Key = c.Customer_Key
WHERE f.Transaction_Type='Deposit'
GROUP BY c.Customer_Name;

--Total Withdrawal by Customer

SELECT
    c.Customer_Name,
    SUM(f.Amount) AS Withdrawal_Amount
FROM Fact_Transactions f
JOIN Dim_Customer c
ON f.Customer_Key = c.Customer_Key
WHERE f.Transaction_Type='Withdrawal'
GROUP BY c.Customer_Name;

--Total Transaction Amount by Branch

SELECT
    b.Branch_Name,
    SUM(f.Amount) AS Total_Amount
FROM Fact_Transactions f
JOIN Dim_Branch b
ON f.Branch_Key = b.Branch_Key
GROUP BY b.Branch_Name;


--Total Transaction Amount by City
SELECT
    c.City,
    SUM(f.Amount) AS Total_Amount
FROM Fact_Transactions f
JOIN Dim_Customer c
ON f.Customer_Key = c.Customer_Key
GROUP BY c.City;


--Monthly Transaction Report

SELECT
    d.Month_name,
    SUM(f.Amount) AS Total_Amount
FROM Fact_Transactions f
JOIN Dim_Date d
ON f.Date_Key = d.Date_Key
GROUP BY d.Month_name;

--Savings vs Current Account Analysis
SELECT
    a.Account_Type,
    SUM(f.Amount) AS Total_Amount
FROM Fact_Transactions f
JOIN Dim_Account a
ON f.Account_Key = a.Account_Key
GROUP BY a.Account_Type;

--Top 5 Customers

SELECT *
FROM (
    SELECT
        c.Customer_Name,
        SUM(f.Amount) AS Total_Amount,
        DENSE_RANK() OVER (
            ORDER BY SUM(f.Amount) DESC
        ) AS rnk
    FROM Fact_Transactions f
    JOIN Dim_Customer c
        ON f.Customer_Key = c.Customer_Key
    GROUP BY c.Customer_Name
)
WHERE rnk <= 5;

